def islandMapper(ocean, currPos, adjMap):
    islandSize = 0
    visited = {currPos : 1}
    queue = [currPos]

    while queue:
        currLoc = queue.pop(0)
        islandSize += 1
        for direction in adjMap[currLoc]:
            if(direction not in visited):
                visited[direction] = 1
                queue.append(direction)
    visitedCoords = []
    
    for pos in visited:
        
        visitedCoords.append(pos)
    
    return islandSize, visitedCoords




