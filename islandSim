def mapCreator(rows, cols):
    ocean = []
    for i in range(rows):
        holder = []
        for j in range(cols):
            coinFlip = random.randint(1,2)
            if(coinFlip == 1):
                holder.append("1")
            else:
                holder.append("0")
        ocean.append(holder)
    return ocean

def adjacencyCreator(inputMap):
    adj = {}
    for i in range(len(inputMap)):
        row = inputMap[i]
        for j in range(len(row)):
            currPos = (i,j)
            currVal = row[j]
            adj[currPos] = []
            if(currVal == "1"):
                #look around for neighbors
                directionList = [(1,0),(-1,0),(0,1),(0,-1)]
                for direction in directionList:
                    newPos = (currPos[0] + direction[0], currPos[1] + direction[1])
                    if(newPos[0] >= len(inputMap) or newPos[0] < 0):
                        pass
                    elif(newPos[1] >= len(inputMap[0]) or newPos[1] < 0):
                        pass
                    elif(inputMap[newPos[0]][newPos[1]] == "1" and ((newPos[0],newPos[1]) not in adj[currPos])):
                        adj[currPos].append(newPos)
    return adj


